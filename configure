#!/bin/bash
echo "Setting environnement"
BUILD_DIR=$PWD
debuginfo="no"
no_gcc_opt="no"
release_mode="no"

# Find source path
source_path="`echo $0 | sed -e 's#/configure##'`"
source_path_used="yes"
if test -z "$source_path" -o "$source_path" = "." ; then
    source_path="`pwd`"
    source_path_used="no"
    build_path=$source_path
else
    source_path="`cd \"$source_path\"; pwd`"
    build_path="`pwd`"
fi

for opt do
    case "$opt" in
        --enable-debug) debuginfo="yes"; no_gcc_opt="yes"
            ;;
        --enable-release) release_mode="yes"
            ;;
    esac
done

if test "$release_mode" = "yes" -a -z "$EMCC_CFLAGS"; then
    # Only used when this script is invoked directly (not via the top-level
    # ./configure --enable-release, which already exports this); it makes
    # every emcc/em++ call - including the third-party libraries built
    # below - favor the smallest possible wasm output.
    export EMCC_CFLAGS="-Oz -DNDEBUG -sASSERTIONS=0"
fi

echo "Updating submodules"
#git submodule update --init

echo "Downloading and building dependencies"
mkdir -p third_parties
cd third_parties

# #git submodule update --init --recursive
if test "$debuginfo" = "no"; then
    if test "$release_mode" = "yes"; then
        $source_path/third_parties/build_thirdparties.sh --enable-release
    else
        $source_path/third_parties/build_thirdparties.sh
    fi
else
    $source_path/third_parties/build_thirdparties.sh --enable-debug
fi

echo "Updating all dependencies"
cd $BUILD_DIR
$source_path/update_libs.sh
